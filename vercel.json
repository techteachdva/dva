{
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": {
    "api/pedagogy/score.js": { "maxDuration": 10 },
    "api/pedagogy/analyze.js": { "maxDuration": 10 },
    "api/pedagogy/questions.js": { "maxDuration": 10 }
  },
  "devCommand": "npm run start",
  "redirects": [
    { "source": "/x-k9-curtly", "destination": "/", "permanent": true },
    { "source": "/x-k9-curtly/", "destination": "/", "permanent": true },
    { "source": "/crystalwizards", "destination": "/crystalwizards/", "permanent": true },
    { "source": "/uriel", "destination": "/uriel/", "permanent": true },
    { "source": "/dragon-trail", "destination": "/dragon-trail/", "permanent": true },
    { "source": "/somnia", "destination": "/somnia/", "permanent": true },
    { "source": "/ainmos", "destination": "/ainmos/", "permanent": true },
    { "source": "/physix", "destination": "/physix/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/somnia-saves", "destination": "/api/somnia-highscores?somniaApi=saves" },
    { "source": "/api/ainmos-highscores", "destination": "/api/somnia-highscores?game=ainmos" },
    { "source": "/api/ainmos-saves", "destination": "/api/somnia-highscores?somniaApi=saves&game=ainmos" },
    { "source": "/api/diagnostic-writing/submissions", "destination": "/api/diagnostic-writing-submissions" },
    { "source": "/api/item-diagnostic/submissions", "destination": "/api/item-diagnostic-submissions" },
    { "source": "/api/writeflow/submissions", "destination": "/api/writeflow-submissions" },
    { "source": "/api/tech-trail/submissions", "destination": "/api/tech-trail-submissions" },
    { "source": "/api/tech-trail/roster", "destination": "/api/tech-trail-submissions" },
    { "source": "/physix/", "destination": "/physix/physix.html" }
  ],
  "headers": [
    {
      "source": "/crystalwizards/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/physix/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)\\.pck",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    },
    {
      "source": "/somnia/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/somnia/" }
      ]
    },
    {
      "source": "/somnia/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
