; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Feleco"
config/version="7.2"
run/main_scene="res://scenes/ui/splash.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.071, 0.098, 0.082, 1)
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

GameConfig="*res://scripts/autoloads/game_config.gd"
EraPacks="*res://scripts/autoloads/era_packs.gd"
FXManager="*res://scripts/effects/fx_manager.gd"
Music="*res://scripts/autoloads/music.gd"
Sfx="*res://scripts/autoloads/sfx.gd"
Sparkle="*res://scripts/autoloads/sparkle.gd"
Glass="*res://scripts/autoloads/glass.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=3

[rendering]

renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
