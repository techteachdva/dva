---
title: ITEM 2025 Diagnostic
permalink: /item-diagnostic/
layout: false
---
<!doctype html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#071612" />
    <title>ITEM 2025 Standards Diagnostic</title>
    <meta property="og:title" content="ITEM 2025 Standards Diagnostic" />
    <meta property="og:description" content="Typing warm-up and knowledge quiz to find which technology standards need the most practice." />
    <link rel="stylesheet" href="/styles/write-platform.css" />
    <link rel="stylesheet" href="/styles/custom-style.css" />
  </head>
  <body class="dw-body wp-theme--item">
    <div class="dw-shell">
      {% if breadcrumbs and breadcrumbs.length > 0 %}
        <div class="breadcrumbs--standalone">{% include "components/breadcrumbs.njk" %}</div>
      {% endif %}
      <header class="dw-topbar">
        <div class="dw-topbar-brand">
          <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#34d399,#fbbf24);display:flex;align-items:center;justify-content:center;font-size:24px;">🎯</div>
          <div>
            <div class="dw-title">ITEM 2025 Standards Diagnostic</div>
            <div class="dw-subtitle">Typing warm-up · knowledge check · gap analysis</div>
          </div>
        </div>
        <div class="dw-actions"><a class="dw-link" href="/tech-escape/">Tech Escape</a><a class="dw-link" href="/">Back to site</a><button id="teacherBtn" class="dw-btn dw-btn-ghost" type="button">Teacher view</button></div>
      </header>

      <main>
        <section id="welcomeView" class="dw-stack">
          <div class="dw-card dw-hero">
            <h1 class="dw-h1">Find your technology learning gaps</h1>
            <p class="dw-lead">A short typing warm-up and a 20-question quiz show where you&rsquo;re strong and where to focus next.</p>
            <p class="dw-muted dw-tiny">The quiz draws one random question per ITEM standard from a large bank (answer order and question order are shuffled every time).</p>
          </div>
          <div class="dw-card dw-stack">
            <h2 class="dw-h2">What gets measured</h2>
            <div class="dw-rubric-grid">
              <div class="dw-rubric"><h3 class="dw-h3">⌨️ Typing</h3><p>Speed and stamina on a technology-themed prompt.</p></div>
              <div class="dw-rubric"><h3 class="dw-h3">📚 Knowledge</h3><p>Design, systems, data, digital citizenship, and programming.</p></div>
              <div class="dw-rubric"><h3 class="dw-h3">🎯 Standards map</h3><p>Per-standard scores highlight strengths and gaps.</p></div>
            </div>
          </div>
          <div class="dw-card dw-stack">
            <label class="dw-field"><span class="dw-label">Your first name</span><input id="studentName" class="dw-input" type="text" maxlength="80" autocomplete="name" /></label>
            <label class="dw-field"><span class="dw-label">Your class</span><select id="studentClass" class="dw-input dw-select" required></select></label>
            <label class="dw-field"><span class="dw-label">Class code</span><input id="classCode" class="dw-input" type="text" maxlength="40" autocomplete="off" autocapitalize="off" spellcheck="false" /></label>
            <p id="classCodeError" class="dw-error dw-hidden" role="alert">That code doesn&rsquo;t match your class.</p>
            <button id="startBtn" class="dw-btn" type="button" disabled>Start diagnostic</button>
          </div>
        </section>

        <section id="typingView" class="dw-hidden">
          <div class="dw-card"><h2 class="dw-h2">Typing warm-up</h2>
            <p class="dw-muted">Explain how technology helps solve a problem in your daily life. Type until time runs out.</p></div>
          <div class="dw-timer-bar">
            <div class="dw-timer-meta"><span class="dw-timer-label">Time remaining</span><span id="timerDisplay" class="dw-timer-value">2:00</span></div>
            <div class="dw-timer-track"><div id="timerProgress" class="dw-timer-fill"></div></div>
            <div class="dw-live-stats"><span id="liveWordCount">0 words</span><span id="liveWpm">0 WPM</span></div>
          </div>
          <div class="dw-card dw-writing-card">
            <textarea id="typingInput" class="dw-textarea" placeholder="Technology helps me when…" spellcheck="true"></textarea>
          </div>
        </section>

        <section id="quizView" class="dw-hidden">
          <div class="qz-panel">
            <div class="qz-header">
              <span class="qz-standard" id="quizStandard">ITEM —</span>
              <span class="qz-progress" id="quizProgress">Question 1 of 20</span>
            </div>
            <p id="quizMultiselect" class="qz-multiselect-hint dw-hidden"></p>
            <h2 class="qz-question" id="quizQuestion"></h2>
            <ul class="qz-options" id="quizOptions"></ul>
            <div id="quizFeedback" class="qz-feedback dw-hidden"></div>
            <div class="qz-actions"><button id="quizConfirmBtn" class="dw-btn" type="button" disabled>Confirm answer</button></div>
          </div>
        </section>

        <section id="analyzingView" class="dw-card dw-stack dw-hidden dw-center">
          <div class="dw-spinner"></div>
          <p class="dw-lead">Building your results…</p>
        </section>

        <section id="resultsView" class="dw-hidden dw-stack">
          <div class="dw-card">
            <h2 class="dw-h2">Your diagnostic, <span id="resultName">—</span></h2>
            <p class="dw-muted" id="resultClass"></p>
            <p class="dw-muted" id="resultSummary"></p>
            <p id="saveStatus" class="dw-save-status dw-hidden" role="status"></p>
            <div id="gapSummary"></div>
          </div>
          <div class="dw-card"><h3 class="dw-h3">Typing warm-up</h3><div id="typingSummary"></div></div>
          <div class="dw-card"><h3 class="dw-h3">Topic areas</h3><div id="topicSummary"></div></div>
          <div class="dw-card"><h3 class="dw-h3">Standards breakdown</h3><div class="std-grid" id="standardsGrid"></div></div>
          <button id="restartBtn" class="dw-btn dw-btn-secondary" type="button">Try again</button>
        </section>

        <section id="teacherLoginView" class="dw-card dw-stack dw-hidden dw-narrow">
          <h2 class="dw-h2">Teacher dashboard</h2>
          <p class="dw-muted">Enter the teacher password to view class ITEM diagnostic results.</p>
          <label class="dw-field">
            <span class="dw-label">Password</span>
            <input id="teacherPassword" class="dw-input" type="password" autocomplete="current-password" />
          </label>
          <div class="dw-row">
            <button id="teacherLoginBtn" class="dw-btn" type="button">Enter</button>
            <button id="teacherCancelBtn" class="dw-btn dw-btn-ghost" type="button">Cancel</button>
          </div>
          <p id="teacherLoginError" class="dw-error dw-hidden">Incorrect password.</p>
        </section>

        <section id="teacherView" class="dw-hidden dw-stack dw-teacher-shell">
          <div class="dw-card dw-teacher-header">
            <div>
              <h2 class="dw-h2">ITEM 2025 Diagnostic · Class results</h2>
              <p class="dw-muted" id="teacherMeta">Loading submissions…</p>
            </div>
            <div class="dw-row dw-row-wrap">
              <button id="answerKeyBtn" class="dw-btn dw-btn-ghost" type="button">Answer key</button>
              <button id="refreshBtn" class="dw-btn dw-btn-secondary" type="button">Refresh</button>
              <button id="exportBtn" class="dw-btn dw-btn-ghost" type="button">Export CSV</button>
              <button id="teacherLogoutBtn" class="dw-btn dw-btn-ghost" type="button">Log out</button>
            </div>
          </div>

          <details class="dw-card dw-class-codes" id="classCodesPanel" open>
            <summary class="dw-h3 dw-class-codes__summary">Class codes for students</summary>
            <p class="dw-muted dw-tiny">Share the matching code when students start the diagnostic.</p>
            <div class="dw-class-codes__grid" id="classCodesGrid"></div>
          </details>

          <div class="dw-filter-bar" id="classFilterBar">
            <label class="dw-class-filter">
              <span class="dw-muted">Class</span>
              <select id="classFilter" class="dw-input dw-select dw-select--compact">
                <option value="all">All classes</option>
              </select>
            </label>
          </div>

          <div class="dw-filter-bar" id="typingFilterBar" role="group" aria-label="Filter by typing level">
            <button class="dw-filter dw-filter--active" data-typing-filter="all" type="button">All typing</button>
            <button class="dw-filter" data-typing-filter="intervention" type="button">Needs intervention</button>
            <button class="dw-filter" data-typing-filter="developing" type="button">Developing</button>
            <button class="dw-filter" data-typing-filter="proficient" type="button">Proficient</button>
            <button class="dw-filter" data-typing-filter="advanced" type="button">Advanced</button>
          </div>

          <div class="dw-teacher-view-tabs" id="teacherViewTabs" role="tablist" aria-label="Teacher dashboard view">
            <button id="teacherTabTable" class="dw-teacher-tab dw-teacher-tab--active" type="button" role="tab" aria-selected="true">Scores table</button>
            <button id="teacherTabGroups" class="dw-teacher-tab" type="button" role="tab" aria-selected="false">Group by class</button>
            <button id="teacherTabAnswerKey" class="dw-teacher-tab" type="button" role="tab" aria-selected="false">Answer key</button>
          </div>

          <div class="dw-card dw-table-wrap dw-table-wrap--fit" id="teacherTableWrap">
            <table class="dw-table dw-table--compact" id="teacherTable">
              <thead id="teacherTableHead">
                <tr>
                  <th class="dw-col-view" scope="col"></th>
                  <th scope="col">Name</th>
                  <th scope="col">Class</th>
                  <th scope="col">Quiz</th>
                  <th scope="col">WPM</th>
                  <th scope="col">Typing</th>
                  <th scope="col">Gaps</th>
                  <th scope="col">Standards to teach</th>
                  <th scope="col">Submitted</th>
                </tr>
              </thead>
              <tbody id="teacherTableBody"></tbody>
            </table>
            <p id="emptyState" class="dw-muted dw-center dw-hidden">No submissions yet.</p>
          </div>

          <div id="teacherGroupsWrap" class="dw-hidden dw-stack idt-groups" aria-label="Class groups"></div>

          <div id="teacherAnswerKeyWrap" class="dw-hidden dw-stack idt-answer-key" aria-label="Question bank answer key"></div>

          <div id="detailPanel" class="dw-card dw-detail dw-hidden">
            <div class="dw-detail-header">
              <h3 class="dw-h3" id="detailName">—</h3>
              <button id="closeDetailBtn" class="dw-btn dw-btn-ghost" type="button">Close</button>
            </div>
            <p class="dw-muted" id="detailSummary"></p>
            <h4 class="dw-h3">Standards breakdown</h4>
            <div class="std-grid" id="detailStandards"></div>
            <h4 class="dw-h3">Topic areas</h4>
            <div id="detailTopics"></div>
            <h4 class="dw-h3">Typing warm-up</h4>
            <div class="dw-story-preview" id="detailTyping"></div>
            <h4 class="dw-h3">Questions to review (missed)</h4>
            <div id="detailWrongQuestions"></div>
            <h4 class="dw-h3">All quiz answers</h4>
            <div id="detailQuiz"></div>
          </div>
        </section>
      </main>
    </div>

    <script id="itemClassroomsJson" type="application/json">{{ diagnosticWritingClasses | jsonify | safe }}</script>
    <script id="itemClassroomCodesJson" type="application/json">{{ diagnosticWritingClassCodes | jsonify | safe }}</script>
    <script src="/scripts/write-test-core.js" defer></script>
    <script src="/scripts/writeflow-item-standards.js" defer></script>
    <script src="/scripts/diagnostic-writing-calibration.js" defer></script>
    <script src="/scripts/write-analysis-engine.js" defer></script>
    <script src="/scripts/item-diagnostic-questions.js" defer></script>
    <script type="module" src="/scripts/item-diagnostic-loader.js"></script>
    <script src="/scripts/item-diagnostic-app.js" defer></script>
    <script src="/scripts/item-diagnostic-teacher.js" defer></script>
  </body>
</html>
