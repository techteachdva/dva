---
title: Summer Story Diagnostic
permalink: /diagnostic-writing/
layout: false
---
<!doctype html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>Summer Writing Assignment Test</title>
    <meta property="og:title" content="Summer Writing Assignment Test" />
    <meta property="og:image" content="/img/diagnostic-writing/summer-writing-test-hero.png" />
    <meta property="og:description" content="5-minute timed summer narrative writing diagnostic for typing, craft, and Minnesota ELA standards." />
    <link rel="stylesheet" href="/styles/diagnostic-writing.css" />
    <link rel="stylesheet" href="/styles/custom-style.css" />
  </head>
  <body class="dw-body">
    <div class="dw-shell">
      {% if breadcrumbs and breadcrumbs.length > 0 %}
        <div class="breadcrumbs--standalone">{% include "components/breadcrumbs.njk" %}</div>
      {% endif %}
      <header class="dw-topbar">
        <div class="dw-topbar-brand">
          <img
            class="dw-topbar-img"
            src="/img/diagnostic-writing/summer-writing-test-hero.png"
            width="72"
            height="40"
            alt=""
            decoding="async"
          />
          <div>
            <div class="dw-title">Summer Writing Assignment Test</div>
            <div class="dw-subtitle">5-minute timed narrative · typing, craft &amp; Minnesota writing standards</div>
          </div>
        </div>
        <div class="dw-actions">
          <a class="dw-link" href="/">Back to site</a>
          <button id="teacherBtn" class="dw-btn dw-btn-ghost" type="button">Teacher view</button>
        </div>
      </header>

      <main id="mainContent">
        <section id="welcomeView" class="dw-stack">
          <div class="dw-hero-banner">
            <img
              class="dw-hero-banner__img"
              src="/img/diagnostic-writing/summer-writing-test-hero.png"
              width="1200"
              height="675"
              alt="Summer writing assignment — pencils, paper, and students telling summer stories"
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="dw-card dw-hero">
            <h1 class="dw-h1">📝 Tell your summer story</h1>
            <p class="dw-lead">
              You will have <strong>five full minutes</strong> to type a personal narrative about
              <strong>something that happened to you over summer break</strong>.
              This is a <em>first draft</em> — write continuously without stopping to perfect.
            </p>
          </div>

          <div class="dw-card dw-stack">
            <h2 class="dw-h2">What this test measures</h2>
            <p class="dw-muted">Use these techniques on purpose — your story will be scored on each area below.</p>
            <div class="dw-rubric-grid">
              <div class="dw-rubric">
                <h3 class="dw-h3">⌨️ Typing</h3>
                <p>How fast you type and how much you write in five minutes (speed + stamina).</p>
              </div>
              <div class="dw-rubric">
                <h3 class="dw-h3">✏️ Mechanics</h3>
                <p>Spelling, capitalization, punctuation, and how sentences are built.</p>
              </div>
              <div class="dw-rubric">
                <h3 class="dw-h3">🌞 Story</h3>
                <p>Your voice (I/my), specific details, word choice, sequence, and narrative craft — scored together as one category.</p>
              </div>
            </div>
          </div>

          <div class="dw-card dw-stack dw-prompt-box">
            <h2 class="dw-h2">Your prompt</h2>
            <blockquote class="dw-prompt-quote">
              Write a story about something that happened to you over summer break.
              Include what happened, where you were, who was there, and how you felt.
            </blockquote>
            <ul class="dw-list dw-checklist">
              <li>Hit <strong>Start</strong> — the timer runs the full five minutes.</li>
              <li>Keep typing until time is up (auto-submits).</li>
              <li>Pasting is disabled — this measures <em>your</em> typing.</li>
              <li>Don&rsquo;t worry about perfection; quantity + craft both count.</li>
            </ul>
            <label class="dw-field">
              <span class="dw-label">Your first name</span>
              <input id="studentName" class="dw-input" type="text" maxlength="80" placeholder="e.g. Jordan" autocomplete="name" />
            </label>
            <label class="dw-field">
              <span class="dw-label">Your class</span>
              <select id="studentClass" class="dw-input dw-select" required>
                <option value="" disabled selected>Select your class…</option>
              </select>
            </label>
            <label class="dw-field" id="classCodeField">
              <span class="dw-label">Class code</span>
              <input id="classCode" class="dw-input" type="text" maxlength="40" placeholder="From your teacher" autocomplete="off" autocapitalize="off" spellcheck="false" />
              <span class="dw-muted dw-tiny">Your teacher will give you the code for your class. It must match the class you selected.</span>
            </label>
            <p id="classCodeError" class="dw-error dw-hidden" role="alert">That code doesn&rsquo;t match the class you selected. Check with your teacher.</p>
            <button id="startBtn" class="dw-btn" type="button" disabled>Start 5-minute timer</button>
          </div>
        </section>

        <section id="writingView" class="dw-hidden">
          <div class="dw-timer-bar">
            <div class="dw-timer-meta">
              <span class="dw-timer-label">Time remaining</span>
              <span id="timerDisplay" class="dw-timer-value">5:00</span>
            </div>
            <div class="dw-timer-track" aria-hidden="true">
              <div id="timerProgress" class="dw-timer-fill"></div>
            </div>
            <div class="dw-live-stats">
              <span id="liveWordCount">0 words</span>
              <span id="liveWpm">0 WPM</span>
            </div>
          </div>

          <div class="dw-card dw-writing-card">
            <div class="dw-prompt-banner">
              <strong>Prompt:</strong> Write a story about something that happened to you over summer break.
              Use sensory details, varied sentences, and your own voice. Type as much as you can!
            </div>
            <textarea id="storyInput" class="dw-textarea" placeholder="Start typing your story here…" spellcheck="true" aria-label="Your summer story"></textarea>
          </div>
          <p class="dw-muted dw-tiny">Keep typing until the timer reaches zero. Focus on spelling, sentence variety, and specific details.</p>
        </section>

        <section id="analyzingView" class="dw-card dw-stack dw-hidden dw-center">
          <div class="dw-spinner" aria-hidden="true"></div>
          <p class="dw-lead">Analyzing typing, mechanics, and story craft…</p>
        </section>

        <section id="resultsView" class="dw-hidden dw-stack">
          <div class="dw-card">
            <h2 class="dw-h2">Your results, <span id="resultName">—</span></h2>
            <p class="dw-muted" id="resultClass">—</p>
            <p class="dw-muted" id="resultSummary">—</p>
            <p id="saveStatus" class="dw-save-status dw-hidden" role="status"></p>
          </div>
          <div class="dw-score-grid dw-score-grid--4" id="scoreGrid"></div>
          <div class="dw-card dw-score-legend dw-hidden" id="scoreLegend">
            <h3 class="dw-h3">How to read your scores</h3>
            <p class="dw-muted">Numbers are rubric points (not letter grades). The <strong>band label</strong> tells you what to work on next.</p>
            <ul class="dw-legend-list">
              <li><span class="dw-band dw-band--strong">Strong</span> 80–100 — solid for a timed first draft</li>
              <li><span class="dw-band dw-band--on_track">On track</span> 65–79 — meeting expectations, keep building</li>
              <li><span class="dw-band dw-band--developing">Developing</span> 50–64 — growing; practice this skill</li>
              <li><span class="dw-band dw-band--needs_support">Needs support</span> below 50 — ask for help here</li>
            </ul>
          </div>
          <div class="dw-card dw-stack">
            <h3 class="dw-h3">Feedback by skill area</h3>
            <ul class="dw-feedback dw-feedback--grouped" id="feedbackList"></ul>
          </div>
          <div class="dw-card dw-stack">
            <h3 class="dw-h3">Your story</h3>
            <div class="dw-story-preview" id="storyPreview"></div>
          </div>
          <button id="restartBtn" class="dw-btn dw-btn-secondary" type="button">Write again</button>
        </section>

        <section id="teacherLoginView" class="dw-card dw-stack dw-hidden dw-narrow">
          <h2 class="dw-h2">Teacher dashboard</h2>
          <p class="dw-muted">Enter the teacher password to view class results and Minnesota ELA standards alignment.</p>
          <label class="dw-field">
            <span class="dw-label">Password</span>
            <input id="teacherPassword" class="dw-input" type="password" autocomplete="current-password" />
          </label>
          <div class="dw-row">
            <button id="teacherLoginBtn" class="dw-btn" type="button">Enter</button>
            <button id="teacherCancelBtn" class="dw-btn dw-btn-ghost" type="button">Cancel</button>
          </div>
          <p id="teacherLoginError" class="dw-error dw-hidden">Incorrect password.</p>
        </section>

        <section id="teacherView" class="dw-hidden dw-stack dw-teacher-shell">
          <div class="dw-card dw-teacher-header">
            <div>
              <h2 class="dw-h2">Class results · Minnesota ELA Writing Standards</h2>
              <p class="dw-muted" id="teacherMeta">Loading submissions…</p>
              <p class="dw-muted dw-tiny">Bands: <span class="dw-band dw-band--strong">Strong</span> <span class="dw-band dw-band--on_track">On track</span> <span class="dw-band dw-band--developing">Developing</span> <span class="dw-band dw-band--needs_support">Needs support</span> — use for grouping, not final grades.</p>
            </div>
            <div class="dw-row dw-row-wrap">
              <button id="teacherGuideBtn" class="dw-btn dw-btn-ghost" type="button">How to read this data</button>
              <button id="reanalyzeBtn" class="dw-btn dw-btn-secondary" type="button">Re-analyze all</button>
              <button id="refreshBtn" class="dw-btn dw-btn-secondary" type="button">Refresh</button>
              <button id="exportBtn" class="dw-btn dw-btn-ghost" type="button">Export CSV</button>
              <button id="teacherLogoutBtn" class="dw-btn dw-btn-ghost" type="button">Log out</button>
            </div>
          </div>

          <details class="dw-card dw-class-codes" id="classCodesPanel" open>
            <summary class="dw-h3 dw-class-codes__summary">Class codes for students</summary>
            <p class="dw-muted dw-tiny">Share the matching code when students join the test. Wrong class + code combinations cannot start.</p>
            <div class="dw-class-codes__grid" id="classCodesGrid"></div>
          </details>

          <div class="dw-filter-bar" id="classFilterBar">
            <label class="dw-class-filter">
              <span class="dw-muted">Class</span>
              <select id="classFilter" class="dw-input dw-select dw-select--compact">
                <option value="all">All classes</option>
              </select>
            </label>
          </div>

          <div class="dw-filter-bar" id="filterBar">
            <button class="dw-filter dw-filter--active" data-filter="all" type="button">All</button>
            <button class="dw-filter" data-filter="intervention" type="button">Needs intervention</button>
            <button class="dw-filter" data-filter="developing" type="button">Developing</button>
            <button class="dw-filter" data-filter="proficient" type="button">Proficient</button>
            <button class="dw-filter" data-filter="advanced" type="button">Advanced</button>
          </div>

          <div class="dw-teacher-view-tabs" id="teacherViewTabs" role="tablist" aria-label="Teacher dashboard view">
            <button id="teacherTabTable" class="dw-teacher-tab dw-teacher-tab--active" type="button" role="tab" aria-selected="true">Scores table</button>
            <button id="teacherTabReader" class="dw-teacher-tab" type="button" role="tab" aria-selected="false">Read class</button>
          </div>

          <div id="teacherTableWrap" class="dw-card dw-table-wrap dw-table-wrap--fit">
            <table class="dw-table dw-table--compact" id="teacherTable">
              <thead>
                <tr>
                  <th class="dw-col-view"></th>
                  <th>Name</th>
                  <th>Class</th>
                  <th>Wds</th>
                  <th>WPM</th>
                  <th>Typ</th>
                  <th>Mech</th>
                  <th>Story</th>
                  <th>Overall</th>
                </tr>
              </thead>
              <tbody id="teacherTableBody"></tbody>
            </table>
            <p id="emptyState" class="dw-muted dw-center dw-hidden">No submissions yet.</p>
          </div>

          <div id="teacherReaderWrap" class="dw-reader dw-hidden" role="tabpanel" aria-label="Read student submissions">
            <div class="dw-reader-toolbar">
              <label class="dw-reader-sort">
                <span class="dw-muted">Sort</span>
                <select id="readerSort" class="dw-input dw-select dw-select--compact">
                  <option value="name">Name (A–Z)</option>
                  <option value="overall-desc">Overall (high → low)</option>
                  <option value="overall-asc">Overall (low → high)</option>
                  <option value="story-desc">Story (high → low)</option>
                  <option value="newest">Newest first</option>
                </select>
              </label>
              <p class="dw-muted dw-tiny" id="readerMeta">Choose a class above, then scroll through every story.</p>
              <button id="readerPrintBtn" class="dw-btn dw-btn-ghost" type="button">Print this list</button>
            </div>
            <div class="dw-reader-layout">
              <nav class="dw-reader-nav" id="readerNav" aria-label="Jump to student">
                <p class="dw-reader-nav__title">Students</p>
                <ol class="dw-reader-nav__list" id="readerNavList"></ol>
              </nav>
              <div class="dw-reader-feed-shell">
                <div class="dw-reader-feed" id="readerFeed" tabindex="0" aria-label="Student stories"></div>
              </div>
            </div>
            <p id="readerEmpty" class="dw-muted dw-center dw-hidden">No submissions match this filter.</p>
          </div>

          <div id="detailPanel" class="dw-card dw-detail dw-hidden">
            <div class="dw-detail-header">
              <h3 class="dw-h3" id="detailName">—</h3>
              <button id="closeDetailBtn" class="dw-btn dw-btn-ghost" type="button">Close</button>
            </div>
            <div id="detailCompareCharts" class="dw-compare-panel"></div>
            <div class="dw-detail-grid" id="detailMetrics"></div>
            <div class="dw-detail-flags" id="detailFlags"></div>
            <div class="dw-standards-panel" id="detailStandards"></div>
            <h4 class="dw-h3">Teacher notes</h4>
            <ul class="dw-feedback" id="detailFeedback"></ul>
            <h4 class="dw-h3">Student story</h4>
            <div class="dw-story-preview" id="detailStory"></div>
          </div>
        </section>
      </main>
    </div>

    <script id="dwClassroomsJson" type="application/json">{{ diagnosticWritingClasses | jsonify | safe }}</script>
    <script id="dwClassroomCodesJson" type="application/json">{{ diagnosticWritingClassCodes | jsonify | safe }}</script>
    <script src="/scripts/diagnostic-writing-rubrics.js" defer></script>
    <script src="/scripts/diagnostic-writing-standards.js" defer></script>
    <script src="/scripts/diagnostic-writing-comparisons.js" defer></script>
    <script src="/scripts/diagnostic-writing.js" defer></script>
  </body>
</html>
