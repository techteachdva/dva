---
title: WriteFlow Studio App
permalink: /writeflow/studio/
layout: false
---
<!doctype html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>WriteFlow Studio</title>
    <link rel="icon" href="/writeflow/assets/wfs-icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="/styles/write-platform.css" />
    <link rel="stylesheet" href="/styles/custom-style.css" />
  </head>
  <body class="dw-body wp-theme--dark wf-landing-body wf-studio-app">
    <a class="wf-skip-link" href="#mainContent">Skip to main content</a>

    {% include "writeflow-intro-splash.njk" %}

    <div class="dw-shell dw-hidden" id="wfStudioShell">
      <div id="wfBootLoader" class="wf-boot-loader dw-hidden" aria-live="polite" aria-busy="true">
        <p class="wf-boot-loader__label">Loading WriteFlow Studio…</p>
        <div class="wf-boot-loader__track" id="wfBootAlphabet" aria-hidden="true"></div>
      </div>
      <header class="dw-topbar" id="studioTopbar">
        <div class="dw-topbar-brand">
          <a href="/writeflow/" class="wf-brand-link">
            <span class="wf-mark-wrap wf-mark-wrap--header" aria-hidden="true">{% include "wfs-mark.svg.njk" %}</span>
            <div>
              <div class="dw-title" id="appTitle">WriteFlow Studio</div>
              <div class="dw-subtitle" id="appSubtitle">Teacher workspace</div>
            </div>
          </a>
        </div>
        <div class="dw-actions" id="teacherTopbarNav">
          <a class="dw-link" href="/writeflow/">Docs</a>
          <button id="tutorialBtn" class="dw-btn dw-btn-ghost wf-tutorial-btn" type="button" aria-haspopup="dialog">Tutorial</button>
          <button id="builderLinkBtn" class="dw-btn dw-btn-ghost" type="button">Assignments</button>
          <button id="teacherBtn" class="dw-btn dw-btn-ghost" type="button">Results</button>
          <button id="wfAccountBtn" class="dw-btn dw-btn-ghost wf-account-btn" type="button" aria-haspopup="dialog" aria-controls="wfAccountPanel">Sign in</button>
        </div>
      </header>

      <div id="wfNameModal" class="wf-modal dw-hidden" role="dialog" aria-modal="true" aria-labelledby="wfNameModalTitle">
        <div class="wf-modal__backdrop" id="wfNameModalBackdrop"></div>
        <div class="wf-modal__panel">
          <h2 class="dw-h2" id="wfNameModalTitle">Name your assignment</h2>
          <p class="dw-muted">This becomes the title and the ID in your student link. You can rename the title later in the builder.</p>
          <label class="dw-field">
            <span class="dw-label">Assignment name</span>
            <input id="wfNameModalInput" class="dw-input" type="text" placeholder="e.g. Photosynthesis paragraph" autocomplete="off" />
          </label>
          <p class="dw-muted dw-tiny">Student link ID: <code id="wfNameModalSlug">—</code></p>
          <div class="dw-row">
            <button id="wfNameModalCancel" class="dw-btn dw-btn-ghost" type="button">Cancel</button>
            <button id="wfNameModalOk" class="dw-btn" type="button">Continue</button>
          </div>
        </div>
      </div>

      <div id="wfConfirm" class="wf-confirm dw-hidden" role="alertdialog" aria-modal="true" aria-labelledby="wfConfirmTitle" aria-describedby="wfConfirmBody">
        <div class="wf-confirm__backdrop" id="confirmBackdrop"></div>
        <div class="wf-confirm__panel">
          <h2 class="wf-confirm__title" id="wfConfirmTitle">Confirm</h2>
          <p class="wf-confirm__body" id="wfConfirmBody"></p>
          <div class="wf-confirm__actions">
            <button id="confirmCancelBtn" class="dw-btn dw-btn-ghost" type="button">Cancel</button>
            <button id="confirmOkBtn" class="dw-btn wf-confirm__danger" type="button">Confirm</button>
          </div>
        </div>
      </div>

      <div id="wfTutorial" class="wf-tutorial dw-hidden" role="dialog" aria-modal="true" aria-labelledby="wfTutorialTitle">
        <div class="wf-tutorial__backdrop" id="tutorialBackdrop"></div>
        <div class="wf-tutorial__panel">
          <div class="wf-tutorial__meta">
            <span class="wf-tutorial__eyebrow" id="wfTutorialEyebrow">Guide</span>
            <span class="wf-tutorial__step" id="wfTutorialStep">1 / 5</span>
          </div>
          <h2 class="wf-tutorial__title" id="wfTutorialTitle">Welcome</h2>
          <p class="wf-tutorial__body" id="wfTutorialBody"></p>
          <div class="wf-tutorial__actions">
            <button id="tutorialSkipBtn" class="dw-btn dw-btn-ghost" type="button">Skip</button>
            <div class="wf-tutorial__nav">
              <button id="tutorialBackBtn" class="dw-btn dw-btn-secondary" type="button">Back</button>
              <button id="tutorialNextBtn" class="dw-btn" type="button">Next</button>
            </div>
          </div>
        </div>
      </div>

      <main id="mainContent">
        <section id="wfHomeView" class="dw-hidden wf-studio-home">
          <div id="wfTeacherPickerBanner" class="wf-teacher-picker-banner dw-hidden" role="status">
            <strong>Choose an assignment</strong> to view student results.
          </div>

          <div class="wf-studio-home__grid" id="wfStudioHomeGrid">
            <aside class="wf-studio-home__panel wf-studio-home__panel--templates" aria-labelledby="wfTemplatesHeading">
              <div class="wf-studio-home__panel-head">
                <h2 class="wf-studio-home__panel-title" id="wfTemplatesHeading">New from template</h2>
                <p class="dw-muted wf-studio-home__panel-lead">Each template sets timer, scoring, and student defaults. Pick one, name it, answer a few questions.</p>
              </div>
              <div class="wf-template-grid wf-template-grid--studio" id="homeTemplateGrid" role="list"></div>
              <button id="openBuilderBtn" class="dw-btn dw-btn-secondary wf-studio-home__blank-btn" type="button">Blank assignment</button>
            </aside>

            <div class="wf-studio-home__panel wf-studio-home__panel--center">
              <div class="wf-studio-home__hero dw-card">
                <div class="wf-studio-home__hero-copy">
                  <h1 class="dw-h1 wf-studio-home__title">Your assignments</h1>
                  <p class="dw-muted wf-studio-home__lead">File tiles in the center — click to edit. Templates on the left, tips on the right.</p>
                </div>
                <button id="openTutorialHomeBtn" class="dw-btn dw-btn-ghost" type="button">Tutorial</button>
              </div>
              <div id="wfAssignmentsDashboard" class="wf-files-grid" role="list" aria-labelledby="wfAssignmentsHeading">
                <h2 class="dw-hidden" id="wfAssignmentsHeading">Your assignments</h2>
              </div>
              <section class="wf-shared-library dw-hidden wf-studio-home__shared" id="wfSharedLibrary" aria-labelledby="wfSharedHeading">
                <h3 class="wf-studio-home__section-title" id="wfSharedHeading">Shared by other teachers</h3>
                <div id="wfSharedDashboard" class="wf-files-grid wf-files-grid--shared" role="list"></div>
              </section>
            </div>

            <aside class="wf-studio-home__panel wf-studio-home__panel--guide" id="wfStudioQuickTips">
              <h2 class="wf-studio-home__panel-title">Quick tips</h2>
              <ul class="wf-studio-tips">
                <li><strong>Name first</strong> — every new assignment starts with a name that becomes the link ID.</li>
                <li><strong>Templates</strong> — show default student experience before you build.</li>
                <li><strong>Student links</strong> — share <code>/writeflow/a/?id=…</code> only, never Studio.</li>
                <li><strong>Results</strong> — use your assignment teacher password or sign in as owner.</li>
              </ul>
              <p class="dw-muted dw-tiny">Sign in from the top bar to sync assignments and browse shared templates.</p>
            </aside>
          </div>

          <section id="wfAccountPanel" class="dw-card wf-account-panel dw-hidden" aria-labelledby="wfAccountHeading">
            <div class="wf-account-panel__head">
              <div>
                <h2 class="dw-h2" id="wfAccountHeading">Teacher account</h2>
                <p class="dw-muted" id="wfAccountSubtitle">Sign in to save assignments to your account and browse shared templates from other teachers.</p>
              </div>
              <button id="wfAccountCloseBtn" class="dw-btn dw-btn-ghost" type="button" aria-label="Close account panel">Close</button>
            </div>
            <div id="wfAccountSignedOut" class="wf-account-panel__body">
              <div class="wf-account-tabs" role="tablist">
                <button id="wfAccountTabLogin" class="wf-account-tab wf-account-tab--active" type="button" role="tab" aria-selected="true">Sign in</button>
                <button id="wfAccountTabRegister" class="wf-account-tab" type="button" role="tab" aria-selected="false">Create account</button>
              </div>
              <form id="wfLoginForm" class="wf-account-form" autocomplete="on">
                <label class="dw-field"><span class="dw-label">Username</span><input id="wfLoginUsername" class="dw-input" type="text" autocomplete="username" required /></label>
                <label class="dw-field"><span class="dw-label">Password</span><input id="wfLoginPassword" class="dw-input" type="password" autocomplete="current-password" required /></label>
                <button class="dw-btn" type="submit">Sign in</button>
              </form>
              <form id="wfRegisterForm" class="wf-account-form dw-hidden" autocomplete="on">
                <label class="dw-field"><span class="dw-label">Username</span><span class="dw-muted dw-tiny">Letters, numbers, dots, dashes — at least 3 characters</span><input id="wfRegisterUsername" class="dw-input" type="text" autocomplete="username" required /></label>
                <label class="dw-field"><span class="dw-label">Display name</span><span class="dw-muted dw-tiny">Shown when you share assignments</span><input id="wfRegisterDisplayName" class="dw-input" type="text" autocomplete="name" /></label>
                <label class="dw-field"><span class="dw-label">Password</span><span class="dw-muted dw-tiny">At least 4 characters</span><input id="wfRegisterPassword" class="dw-input" type="password" autocomplete="new-password" required /></label>
                <button class="dw-btn" type="submit">Create account</button>
              </form>
              <p id="wfAccountError" class="dw-error dw-hidden" role="alert"></p>
            </div>
            <div id="wfAccountSignedIn" class="wf-account-panel__body dw-hidden">
              <p class="wf-account-greeting">Signed in as <strong id="wfAccountDisplayName"></strong> <span class="dw-muted">(<span id="wfAccountUsername"></span>)</span></p>
              <p class="dw-muted dw-tiny">Assignments you save while signed in are linked to your account. Turn on &ldquo;Share with other teachers&rdquo; in the builder to let colleagues copy your work.</p>
              <button id="wfAccountLogoutBtn" class="dw-btn dw-btn-ghost" type="button">Sign out</button>
            </div>
          </section>
        </section>

        <section id="builderView" class="dw-hidden wf-builder-view">
          <div class="wf-builder">
            <nav class="wf-builder-nav wf-builder-panel" id="builderNav" aria-label="Settings">
              <p class="wf-builder-nav__title">Settings</p>
            </nav>
            <div class="wf-builder-canvas wf-builder-panel" id="builderCanvas"></div>
            <aside class="wf-builder-inspector wf-builder-panel" id="builderInspector" aria-label="File information"></aside>
          </div>
        </section>

        <section id="teacherLoginView" class="dw-card dw-stack dw-hidden dw-narrow">
          <h2 class="dw-h2">View results</h2>
          <p class="dw-muted">Enter the <strong>assignment teacher password</strong> you set in the builder. Owners signed into WriteFlow can open results without it; other signed-in teachers still need this password.</p>
          <p class="dw-muted dw-tiny">This password is separate from your WriteFlow account login. It protects student submissions — share it only with co-teachers who need access to results.</p>
          <label class="dw-field"><span class="dw-label">Teacher password</span><input id="teacherPassword" class="dw-input" type="password" autocomplete="current-password" /></label>
          <div class="dw-row">
            <button id="teacherLoginBtn" class="dw-btn" type="button">Enter</button>
            <button id="teacherCancelBtn" class="dw-btn dw-btn-ghost" type="button">Cancel</button>
          </div>
          <p id="teacherLoginError" class="dw-error dw-hidden">Incorrect password.</p>
        </section>

        <section id="teacherView" class="dw-hidden dw-stack">
          <div class="dw-card dw-teacher-header">
            <h2 class="dw-h2">Submissions</h2>
            <p class="dw-muted" id="teacherMeta"></p>
            <div class="dw-row">
              <button id="teacherEditBtn" class="dw-btn dw-btn-secondary" type="button">Edit assignment</button>
              <button id="refreshBtn" class="dw-btn dw-btn-secondary" type="button">Refresh</button>
              <button id="exportBtn" class="dw-btn dw-btn-ghost" type="button">Export CSV</button>
              <button id="teacherHomeBtn" class="dw-btn dw-btn-ghost" type="button">All assignments</button>
              <button id="teacherLogoutBtn" class="dw-btn dw-btn-ghost" type="button">Log out</button>
            </div>
          </div>
          <div class="dw-card dw-table-wrap">
            <table class="dw-table dw-table--compact">
              <thead><tr id="teacherTableHead"><th>Name</th><th>Class</th><th>Wds</th><th>WPM</th><th>Vocab</th><th>Typ</th><th>Mech</th><th>Story</th><th>Overall</th><th>Submitted</th><th></th></tr></thead>
              <tbody id="teacherTableBody"></tbody>
            </table>
          </div>
          <div id="teacherSubmissionDetail" class="dw-card dw-hidden">
            <h3 class="dw-h3">Submission detail</h3>
            <p class="dw-muted" id="teacherDetailMeta"></p>
            <div id="teacherVocabSummary" class="wf-vocab-summary dw-hidden"></div>
            <div class="dw-story-preview wf-story-preview--highlight" id="teacherStoryPreview"></div>
          </div>
        </section>
      </main>
    </div>

    <script>window.WRITEFLOW_ROLE = "studio";</script>
    <script id="wfClassroomsJson" type="application/json">{{ diagnosticWritingClasses | jsonify | safe }}</script>
    <script id="wfClassroomCodesJson" type="application/json">{{ diagnosticWritingClassCodes | jsonify | safe }}</script>
    <script src="/scripts/write-test-core.js" defer></script>
    <script src="/scripts/writeflow-defaults.js" defer></script>
    <script src="/scripts/writeflow-teacher.js" defer></script>
    <script src="/scripts/writeflow-intro.js" defer></script>
    <script src="/scripts/diagnostic-writing-calibration.js" defer></script>
    <script src="/scripts/diagnostic-writing-rubrics.js" defer></script>
    <script src="/scripts/write-analysis-engine.js" defer></script>
    <script src="/scripts/writeflow-app.js" defer></script>
  </body>
</html>
