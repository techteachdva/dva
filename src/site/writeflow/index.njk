---
title: WriteFlow Studio
permalink: /writeflow/
layout: false
---
<!doctype html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>WriteFlow Studio · Timed writing for classrooms</title>
    <meta property="og:title" content="WriteFlow Studio" />
    <meta property="og:description" content="Timed writing assignments with prompts, vocabulary goals, typing analysis, and teacher dashboards." />
    <link rel="icon" href="/writeflow/assets/wfs-icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="/styles/write-platform.css" />
    <link rel="stylesheet" href="/styles/custom-style.css" />
    <script>
      (function () {
        var p = new URLSearchParams(location.search);
        if (!p.toString()) return;
        if (p.has("id") && !p.get("mode") && p.get("teacher") !== "1") {
          location.replace("/writeflow/a/" + location.search);
          return;
        }
        location.replace("/writeflow/studio/" + location.search);
      })();
    </script>
  </head>
  <body class="dw-body wp-theme--dark wf-landing-body">
    <a class="wf-skip-link" href="#wfLandingMain">Skip to main content</a>

    <div id="wfIntroSplash" class="wf-intro-splash" aria-hidden="false">
      <div class="wf-intro-splash__stage" id="wfIntroStage" data-step="0">
        <div class="wf-intro-morph" id="wfIntroMorph" aria-hidden="false">
          <div class="wf-intro-morph__frame" aria-hidden="true"></div>

          <div class="wf-intro-morph__title" id="wfIntroTitle">
            <span class="wf-intro-typewriter" id="wfIntroTypewriter" aria-live="polite"></span>
            <span class="wf-intro-cursor" id="wfIntroCursor" aria-hidden="true">|</span>
          </div>

          <p class="wf-intro-morph__tag" id="wfIntroTag">Analyzing draft…</p>

          <div class="wf-intro-morph__scores" id="wfIntroScores" aria-hidden="true">
            <div class="wf-intro-morph__score">
              <span class="wf-intro-morph__score-label">Typing</span>
              <span class="wf-intro-morph__score-val" data-score="typing">0</span>
            </div>
            <div class="wf-intro-morph__score">
              <span class="wf-intro-morph__score-label">Mechanics</span>
              <span class="wf-intro-morph__score-val" data-score="mechanics">0</span>
            </div>
            <div class="wf-intro-morph__score">
              <span class="wf-intro-morph__score-label">Content</span>
              <span class="wf-intro-morph__score-val" data-score="story">0</span>
            </div>
          </div>

          <div class="wf-mark-wrap wf-mark-wrap--intro" id="wfIntroLogo" aria-hidden="true">
            {% include "wfs-mark.svg.njk" %}
          </div>
        </div>
      </div>
    </div>

    <div class="wf-landing dw-hidden" id="wfLanding">
      <header class="wf-landing__header">
        <div class="wf-landing__brand">
          <div class="wf-mark-wrap wf-mark-wrap--header" aria-hidden="true">
            {% include "wfs-mark.svg.njk" %}
          </div>
          <div>
            <div class="wf-landing__title">WriteFlow Studio</div>
            <div class="wf-landing__version">Version <span id="wfVersionLabel">2.0</span></div>
          </div>
        </div>
        <nav class="wf-landing__nav" aria-label="WriteFlow">
          <a class="dw-link" href="/">Back to site</a>
          <a class="dw-btn dw-btn-secondary" href="/writeflow/studio/" data-wf-app-link>Open Studio</a>
        </nav>
      </header>

      <main id="wfLandingMain" class="wf-landing__main">
        <section class="wf-landing-hero dw-card">
          <p class="wf-landing-hero__eyebrow">Classroom writing tool</p>
          <h1 class="dw-h1">Timed writing that meets every learner where they are.</h1>
          <p class="dw-lead">WriteFlow Studio lets teachers build assignments with custom prompts, timers, vocabulary goals, and accessibility options. Students get a focused writing screen — no clutter, no paste, just type.</p>
          <div class="wf-landing-hero__cta">
            <a class="dw-btn wf-landing-cta" href="/writeflow/studio/" data-wf-app-link>
              <span class="wf-mark-wrap wf-mark-wrap--cta" aria-hidden="true">{% include "wfs-mark.svg.njk" %}</span>
              Open WriteFlow Studio
            </a>
            <button class="dw-btn dw-btn-ghost" type="button" id="replayIntroBtn">Replay intro</button>
            <a class="dw-btn dw-btn-ghost" href="/writeflow/setup/">Setup guide</a>
          </div>
          <p class="dw-muted dw-tiny">Student assignment links look like <code>/writeflow/a/?id=your-assignment</code> — share only those with students.</p>
        </section>

        <section class="wf-landing-stats dw-card" aria-labelledby="wfStatsTitle">
          <h2 class="dw-h2" id="wfStatsTitle">Impact so far</h2>
          <div class="wf-landing-stats__grid">
            <div class="wf-landing-stat">
              <span class="wf-landing-stat__value" id="wfClassroomCount">—</span>
              <span class="wf-landing-stat__label">Classrooms</span>
            </div>
            <div class="wf-landing-stat">
              <span class="wf-landing-stat__value" id="wfAssignmentCount">—</span>
              <span class="wf-landing-stat__label">Assignments</span>
            </div>
            <div class="wf-landing-stat">
              <span class="wf-landing-stat__value" id="wfSubmissionCount">—</span>
              <span class="wf-landing-stat__label">Submissions</span>
            </div>
            <div class="wf-landing-stat">
              <span class="wf-landing-stat__value" id="wfSentenceCount">—</span>
              <span class="wf-landing-stat__label">Sentences analyzed</span>
            </div>
          </div>
        </section>

        <section class="wf-landing-welcome dw-card">
          <h2 class="dw-h2">What is WriteFlow?</h2>
          <div class="wf-landing-columns">
            <div>
              <h3 class="dw-h3">For teachers</h3>
              <p class="dw-muted">Build assignments in WriteFlow Studio — set prompts, time limits, minimum word counts, expected vocabulary, and class codes. Save and publish to get a student link. Open Results to review submissions, highlight vocabulary usage, and export CSV.</p>
            </div>
            <div>
              <h3 class="dw-h3">For students</h3>
              <p class="dw-muted">Students open only their assignment link. They see the prompt, a timer, live word count and WPM, and a typing area. Pasting is blocked by default. When time is up (or they finish early), WriteFlow analyzes typing stamina, mechanics, and content.</p>
            </div>
          </div>
        </section>

        <section class="wf-landing-tutorial dw-card" aria-labelledby="wfTutorialTitle">
          <h2 class="dw-h2" id="wfTutorialTitle">Quick tutorial</h2>
          <ol class="wf-quickstart__steps" id="wfLandingTutorial"></ol>
        </section>

        <section class="wf-landing-changelog dw-card" aria-labelledby="wfChangelogTitle">
          <h2 class="dw-h2" id="wfChangelogTitle">Changelog</h2>
          <p class="dw-muted">Living documentation of features and fixes.</p>
          <div id="wfChangelogFull" class="wf-changelog-full"></div>
          <div id="wfChangelogSimple" class="wf-changelog-simple"></div>
        </section>
      </main>

      <footer class="wf-landing__footer dw-muted">
        <p>WriteFlow Studio · Mr. Phil's classroom tools · Not a writing platform built for games — built for classrooms.</p>
      </footer>
    </div>

    <script src="/scripts/writeflow-defaults.js" defer></script>
    <script src="/scripts/writeflow-landing.js" defer></script>
  </body>
</html>
