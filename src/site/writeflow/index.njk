---
title: WriteFlow Studio
permalink: /writeflow/
layout: false
---
<!doctype html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>WriteFlow Studio · Timed writing for classrooms</title>
    <meta property="og:title" content="WriteFlow Studio" />
    <meta property="og:description" content="Timed writing assignments with prompts, vocabulary goals, typing analysis, and teacher dashboards." />
    <link rel="icon" href="/writeflow/assets/wfs-icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" />
    <link rel="stylesheet" href="/styles/write-platform.css" />
    <link rel="stylesheet" href="/styles/custom-style.css" />
    <script>
      (function () {
        var p = new URLSearchParams(location.search);
        if (!p.toString()) return;
        if (p.has("id") && !p.get("mode") && p.get("teacher") !== "1") {
          location.replace("/writeflow/a/" + location.search);
          return;
        }
        location.replace("/writeflow/studio/" + location.search);
      })();
    </script>
  </head>
  <body class="dw-body wp-theme--dark wf-landing-body">
    <a class="wf-skip-link" href="#wfLandingMain">Skip to main content</a>

    {% include "writeflow-intro-splash.njk" %}

    <div class="wf-landing dw-hidden" id="wfLanding">
      <header class="wf-landing__header">
        <div class="wf-landing__brand">
          <div class="wf-mark-wrap wf-mark-wrap--header" aria-hidden="true">
            {% include "wfs-mark.svg.njk" %}
          </div>
          <div>
            <div class="wf-landing__title">WriteFlow Studio</div>
            <div class="wf-landing__version">Version <span id="wfVersionLabel">2.3.4</span></div>
          </div>
        </div>
        <nav class="wf-landing__nav" aria-label="WriteFlow">
          <a class="dw-btn dw-btn-secondary" href="/writeflow/studio/" target="_blank" rel="noopener">Open Studio</a>
        </nav>
      </header>

      <main id="wfLandingMain" class="wf-landing__main">
        <aside class="wf-landing__panel wf-landing__panel--changelog" aria-labelledby="wfChangelogTitle">
          <h2 class="wf-landing__panel-title" id="wfChangelogTitle">Changelog</h2>
          <p class="wf-landing__panel-lead dw-muted">Living documentation of features and fixes.</p>
          <div id="wfChangelogFull" class="wf-changelog-full wf-changelog-full--compact"></div>
        </aside>

        <div class="wf-landing__center">
          <section class="wf-landing-hero dw-card wf-landing-hero--compact">
            <p class="wf-landing-hero__eyebrow">Classroom writing tool</p>
            <h1 class="dw-h1 wf-landing-hero__title">Timed writing that meets every learner where they are.</h1>
            <p class="dw-lead wf-landing-hero__lead">Build assignments with custom prompts, timers, vocabulary goals, and accessibility options. Students get a focused writing screen — no clutter, no paste, just type.</p>
            <div class="wf-landing-hero__cta">
              <a class="dw-btn wf-landing-cta" href="/writeflow/studio/" target="_blank" rel="noopener">
                <span class="wf-mark-wrap wf-mark-wrap--cta" aria-hidden="true">{% include "wfs-mark.svg.njk" %}</span>
                Open WriteFlow Studio
              </a>
              <a class="dw-btn dw-btn-ghost" href="/writeflow/setup/">Setup guide</a>
            </div>
          </section>

          <section class="wf-landing-stats dw-card wf-landing-stats--compact" aria-labelledby="wfStatsTitle">
            <h2 class="wf-landing__section-title" id="wfStatsTitle">Impact so far</h2>
            <div class="wf-landing-stats__grid">
              <div class="wf-landing-stat">
                <span class="wf-landing-stat__value" id="wfClassroomCount">—</span>
                <span class="wf-landing-stat__label">Classrooms</span>
              </div>
              <div class="wf-landing-stat">
                <span class="wf-landing-stat__value" id="wfAssignmentCount">—</span>
                <span class="wf-landing-stat__label">Assignments</span>
              </div>
              <div class="wf-landing-stat">
                <span class="wf-landing-stat__value" id="wfSubmissionCount">—</span>
                <span class="wf-landing-stat__label">Submissions</span>
              </div>
              <div class="wf-landing-stat">
                <span class="wf-landing-stat__value" id="wfSentenceCount">—</span>
                <span class="wf-landing-stat__label">Sentences analyzed</span>
              </div>
            </div>
          </section>

          <section class="wf-landing-welcome dw-card wf-landing-welcome--compact">
            <h2 class="wf-landing__section-title">What is WriteFlow?</h2>
            <div class="wf-landing-columns">
              <div>
                <h3 class="dw-h3 wf-landing__mini-title">For teachers</h3>
                <p class="dw-muted wf-landing__dense-text">Build in Studio — prompts, timers, vocabulary, class codes. Save to publish a student link. Open Results to review submissions and export CSV.</p>
              </div>
              <div>
                <h3 class="dw-h3 wf-landing__mini-title">For students</h3>
                <p class="dw-muted wf-landing__dense-text">Students open only their assignment link: prompt, timer, word count, and typing area. Pasting is blocked by default. WriteFlow scores stamina, mechanics, and content.</p>
              </div>
            </div>
          </section>
        </div>

        <aside class="wf-landing__panel wf-landing__panel--guide" aria-labelledby="wfTutorialTitle">
          <h2 class="wf-landing__panel-title" id="wfTutorialTitle">Quick start</h2>
          <ol class="wf-quickstart__steps wf-quickstart__steps--compact" id="wfLandingTutorial"></ol>
          <div class="wf-landing__panel-note dw-card">
            <p class="dw-muted dw-tiny"><strong>Student links only:</strong> <code>/writeflow/a/?id=your-assignment</code> — never share the Studio URL with students.</p>
            <p class="dw-muted dw-tiny">Full interactive tutorial inside Studio after you sign in.</p>
          </div>
        </aside>
      </main>

      <footer class="wf-landing__footer dw-muted">
        <p>WriteFlow Studio · Mr. Phil's classroom tools · Built for classrooms.</p>
      </footer>
    </div>

    <script src="/scripts/writeflow-defaults.js" defer></script>
    <script src="/scripts/writeflow-intro.js" defer></script>
    <script src="/scripts/writeflow-landing.js" defer></script>
  </body>
</html>
