---
title: WriteFlow Admin — All Results
permalink: /writeflow/admin/results/
layout: false
---
<!doctype html>
<html lang="{{ meta.mainLanguage }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <title>WriteFlow Admin — All Results</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/writeflow/assets/wfs-icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/write-platform.css" />
    <link rel="stylesheet" href="/styles/custom-style.css" />
  </head>
  <body class="dw-body wp-theme--dark wf-admin-portal wf-admin-results">
    <a class="wf-skip-link" href="#mainContent">Skip to main content</a>
    <div class="dw-shell dw-shell--wide">
      <header class="wf-portal-header wf-admin-results__header">
        <div>
          <h1 class="dw-h1">All WriteFlow results</h1>
          <p class="dw-muted" id="adminResultsMeta">Loading submissions…</p>
        </div>
        <div class="wf-admin-results__toolbar">
          <span id="adminGradingQueueStatus" class="wf-grading-queue-status dw-muted dw-tiny" role="status" aria-live="polite"></span>
          <button id="adminSaveAllPendingBtn" class="dw-btn dw-btn-secondary" type="button" disabled>Save pending</button>
          <a class="dw-btn dw-btn-ghost" href="/writeflow/admin/">← Admin portal</a>
          <button id="adminResultsRefreshBtn" class="dw-btn dw-btn-secondary" type="button">Refresh</button>
          <button id="adminResultsReanalyzeBtn" class="dw-btn" type="button">Re-analyze all results</button>
        </div>
      </header>

      <main id="mainContent" class="wf-portal-main">
        <section id="adminResultsSignedOut" class="dw-card dw-stack dw-narrow dw-hidden">
          <h2 class="dw-h2">Admin sign-in required</h2>
          <p class="dw-muted">Sign in at the admin portal first, then open this page again.</p>
          <a class="dw-btn" href="/writeflow/admin/">Go to admin portal</a>
        </section>

        <section id="adminResultsSignedIn" class="dw-hidden wf-admin-results__body">
          <div class="dw-card wf-admin-results__filters">
            <label class="dw-field wf-admin-results__filter">
              <span class="dw-label">Assignment</span>
              <select id="adminResultsAssignmentFilter" class="dw-input dw-select">
                <option value="">All assignments</option>
              </select>
            </label>
            <label class="dw-field wf-admin-results__filter">
              <span class="dw-label">Classroom</span>
              <select id="adminResultsClassroomFilter" class="dw-input dw-select">
                <option value="">All classrooms</option>
              </select>
            </label>
            <label class="dw-field wf-admin-results__filter wf-admin-results__filter--search">
              <span class="dw-label">Search student</span>
              <input id="adminResultsSearch" class="dw-input" type="search" placeholder="Name or username" autocomplete="off" />
            </label>
          </div>

          <div class="wf-admin-results__split" id="adminResultsSplit">
            <div class="wf-admin-results__table-panel dw-card dw-table-wrap">
              <table class="dw-table dw-table--compact wf-admin-results__table">
                <thead>
                  <tr id="adminResultsTableHead"></tr>
                </thead>
                <tbody id="adminResultsTableBody"></tbody>
              </table>
            </div>
            <aside id="adminResultsDetail" class="wf-admin-results__detail dw-card wf-admin-results__detail--empty">
              <div class="wf-admin-results__detail-head">
                <h2 class="dw-h3">Grade submission</h2>
                <div class="wf-grading-nav">
                  <button id="adminPrevSubmissionBtn" class="dw-btn dw-btn-ghost dw-btn--compact" type="button" title="Previous submission (Alt+↑)">↑</button>
                  <button id="adminNextSubmissionBtn" class="dw-btn dw-btn-ghost dw-btn--compact" type="button" title="Next submission (Alt+↓)">↓</button>
                  <button id="adminResultsDetailClose" class="dw-btn dw-btn-ghost dw-btn--compact" type="button">Close</button>
                </div>
              </div>
              <p id="adminResultsDetailPlaceholder" class="dw-muted">Select a row to read the draft and enter a grade. Changes queue automatically — use Save pending or Ctrl+Enter to save and advance.</p>
              <div id="adminResultsDetailContent" class="dw-hidden wf-grading-panel">
                <div class="wf-grading-panel__meta">
                  <p class="wf-grading-panel__student" id="adminResultsDetailMeta"></p>
                  <p class="dw-muted dw-tiny" id="adminResultsDetailAssignment"></p>
                  <p class="wf-grading-scores-strip" id="adminResultsDetailScores"></p>
                  <p class="dw-muted dw-tiny dw-hidden" id="adminResultsGradingNotice"></p>
                </div>

                <section class="wf-grading-draft" aria-labelledby="adminDraftLabel">
                  <h3 class="wf-grading-draft__label" id="adminDraftLabel">Student writing</h3>
                  <div class="wf-grading-draft__text dw-hidden" id="adminResultsDraft"></div>
                  <p class="dw-muted dw-tiny dw-hidden" id="adminResultsDraftNote"></p>
                </section>

                <section id="adminResultsGradingPanel" class="wf-teacher-grading wf-grading-form" aria-labelledby="adminGradingTitle">
                  <h4 class="wf-teacher-grading__title" id="adminGradingTitle">Your evaluation</h4>
                  <p class="dw-muted dw-tiny" id="adminGradingHint">Suggested points are based on the auto score. Override anytime — students see this when you release feedback.</p>
                  <label class="dw-field wf-grading-form__points">
                    <span class="dw-label">Points</span>
                    <input id="adminGradeInput" class="dw-input wf-grading-form__grade-input" type="number" min="0" step="0.5" inputmode="decimal" />
                  </label>
                  <label class="dw-field">
                    <span class="dw-label">Feedback for student</span>
                    <textarea id="adminFeedbackInput" class="dw-textarea wf-grading-form__feedback" rows="3" placeholder="What went well? What should they revise?"></textarea>
                  </label>
                  <label class="wf-toggle-row">
                    <input id="adminFeedbackVisible" type="checkbox" />
                    <span class="wf-toggle-row__label"><strong>Release to student</strong><span class="wf-toggle-row__hint">Student sees grade and feedback in My writing when signed in</span></span>
                  </label>
                  <div class="dw-row wf-teacher-grading__actions">
                    <button id="adminGradeSaveBtn" class="dw-btn" type="button" title="Save and go to next (Ctrl+Enter)">Save &amp; next</button>
                    <span id="adminGradeStatus" class="dw-muted dw-tiny" role="status"></span>
                  </div>
                </section>

                <details class="wf-grading-guide-collapse">
                  <summary>Grading guide</summary>
                  <p class="wf-grading-guide" role="note">
                    <strong>Full credit (100%)</strong> requires answering the prompt with correct spelling, punctuation, capitalization, grammar, and syntax.
                    Strong answer with weak conventions, or strong conventions without answering the prompt, should not exceed 50%.
                    Auto scores are a starting suggestion only — use your judgment.
                  </p>
                </details>

                <p class="wf-grading-panel__footer"><a id="adminResultsStudioLink" class="dw-link" target="_blank" rel="noopener noreferrer">Open assignment results in Studio ↗</a></p>
              </div>
            </aside>
          </div>
        </section>
      </main>
    </div>

    <script src="/scripts/writeflow-admin-auth.js" defer></script>
    <script src="/scripts/writeflow-grading-queue.js" defer></script>
    <script src="/scripts/writeflow-item-standards.js" defer></script>
    <script src="/scripts/diagnostic-writing-calibration.js" defer></script>
    <script src="/scripts/diagnostic-writing-rubrics.js" defer></script>
    <script src="/scripts/write-analysis-engine.js" defer></script>
    <script src="/scripts/writeflow-admin-results.js" defer></script>
  </body>
</html>
