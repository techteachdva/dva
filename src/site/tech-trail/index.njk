                    <strong class="tt-map-flyover__title">Campus Overview</strong>
                    <p class="tt-map-flyover__sub">Overhead view — click a labeled floor to travel · click a hero portrait to hear their story</p>
                  </div>
                  <button id="mapFlyoverCloseBtn" class="tt-settings-btn" type="button">Close <kbd>Z</kbd></button>
                </div>
              </div>
              <div id="npcDialog" class="tt-npc-dialog dw-hidden" role="dialog" aria-modal="true" aria-labelledby="npcDialogTitle" aria-hidden="true">
                <div class="tt-npc-dialog__panel">
